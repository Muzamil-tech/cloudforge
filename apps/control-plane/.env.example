APP_NAME=CloudForge
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cloudforge.example.com
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# The control plane requires PostgreSQL in production.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cloudforge
DB_USERNAME=cloudforge
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=cloudforge

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="cloudforge@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Agent control-plane settings
CLOUDFORGE_ALLOW_REGISTRATION=true
CLOUDFORGE_AGENT_ENROLLMENT_TTL_MINUTES=15
CLOUDFORGE_AGENT_HEARTBEAT_TIMEOUT_SECONDS=90
CLOUDFORGE_AGENT_CERTIFICATE_TTL_DAYS=365
CLOUDFORGE_AGENT_CA_PATH=
CLOUDFORGE_AGENT_COMMAND_TTL_SECONDS=300
CLOUDFORGE_AGENT_MAX_POLL_WAIT_SECONDS=25
CLOUDFORGE_AGENT_INSTALL_URL=https://cloudforge.example.com/install.sh

# Set to true only when a trusted TLS terminator has verified the client
# certificate and forwards its serial number in the configured header.
CLOUDFORGE_REQUIRE_CLIENT_CERT_HEADER=false
CLOUDFORGE_CLIENT_CERT_SERIAL_HEADER=X-Client-Cert-Serial

CLOUDFORGE_METRICS_RETENTION_DAYS=14

VITE_APP_NAME="${APP_NAME}"
